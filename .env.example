# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google OAuth Client ID (Web application), used for both the Google Drive
# upload integration and the Semester Survey Generator. See CLAUDE.md for
# Google Cloud Console setup steps.
VITE_GOOGLE_CLIENT_ID=

# Semester Survey Generator — Google Drive folder IDs (from each folder's URL:
# https://drive.google.com/drive/folders/<ID>). See the "Semester Survey
# Generator" section in CLAUDE.md.
VITE_GOOGLE_TEMPLATE_FOLDER_ID=
VITE_GOOGLE_ROOT_SURVEYS_FOLDER_ID=
